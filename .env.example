# MongoDB Atlas connection string. Required — the app refuses to start without it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Port for the local server. Ignored on serverless platforms.
PORT=3000

# Requests allowed per IP per 15 minutes, applied to /api only. Defaults to 100.
# Raise it for development: React StrictMode double-fires effects and every
# hot reload refetches.
RATE_LIMIT_MAX=1000

# Clerk Secret Key, from the API keys page of the Clerk dashboard. This is the
# key beginning sk_test_ or sk_live_ — the *secret* key, not the publishable one
# (pk_...). It verifies session tokens on write routes, so treat it like a
# password: never commit it, and set it directly in Render and Vercel.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Publishable Key, from the same page. Public by design — the frontend
# ships it in its bundle — but clerkMiddleware needs it server-side to resolve
# which Clerk instance a token belongs to, so it is required here too.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Clerk user ID of the single account allowed to write. Found in the Clerk
# dashboard under Users, after that person has signed in at least once. Every
# other signed-in account gets a 403, so leaving this unset closes writes
# entirely rather than opening them.
ADMIN_USER_ID=user_your_clerk_user_id

# Comma-separated list of allowed origins. Defaults to "*" when unset.
# Vercel generates a unique URL per preview deploy, so a fixed list will reject
# every preview build of the frontend.
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Stripe Secret Key, from the Developers > API keys page of the Stripe
# dashboard. Test mode only (starts sk_test_) — this project has no path to a
# live key. Missing this closes /api/checkout with a 500 rather than failing
# unhelpfully inside the Stripe SDK.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Where Stripe redirects back to after checkout succeeds or is cancelled.
# Defaults to the local Vite dev server if unset.
FRONTEND_URL=http://localhost:5173
